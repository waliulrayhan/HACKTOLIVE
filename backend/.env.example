# ===================================
# Backend Environment Variables Template
# Copy to .env for local or .env.production for production
# ===================================

# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/database_name"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Email Configuration
NOREPLY_EMAIL=noreply@yourdomain.com
NOREPLY_PASSWORD=your-noreply-password
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PASSWORD=your-support-password
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
LOGIN_OTP_ENABLED=false

# EPS Payment Gateway Configuration
EPS_MERCHANT_ID=your-merchant-id
EPS_STORE_ID=your-store-id
EPS_USERNAME=your-eps-username
EPS_PASSWORD=your-eps-password
EPS_HASH_KEY=your-eps-hash-key
EPS_IS_LIVE=false

# Application URLs for payment callbacks
BACKEND_URL=http://localhost:4000
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_FAIL_URL=http://localhost:3000/payment/failed
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Cloudflare Turnstile Configuration
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
