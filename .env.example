# ==============================================
# HackToLive Root Environment Template
# ==============================================
# This root env file is for stack-level scripts only.
# App runtime config must be set in:
# - backend/.env (local)
# - backend/.env.production (production)
# - frontend/.env.local (local)
# - frontend/.env.production (production)

# MySQL root password (used by backup/ops scripts if needed)
MYSQL_ROOT_PASSWORD=change-me

# Default DB name used by scripts
MYSQL_DATABASE=hacktolive
